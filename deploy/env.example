# Copiare in .env nella cartella del progetto e adattare i percorsi.
SEATV_DB_PATH=/var/www/vhosts/example.it/seatv/data/seatv.sqlite3
# Una o più chiavi separate da virgola; generarle con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
SEATV_API_KEYS=cambiami
# Giorni di guida scaricati da oggi in avanti (anche i giorni scelti nella pagina web).
SEATV_DAYS_AHEAD=7
# L'aggiornamento lo fa l'attività pianificata di Plesk alle 05:00.
SEATV_SCHEDULER=false
